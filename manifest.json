{
  "id": "iq.masroofi.app",
  "name": "Masroofi — مصروفي",
  "short_name": "مصروفي",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "orientation": "portrait",
  "background_color": "#102542",
  "theme_color": "#102542",
  "description": "مدير المصاريف العراقي الذكي مع المزامنة السحابية عبر حساب Google",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["finance", "productivity", "utilities"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://d7laoez.github.io/msrofe/manifest.json",
      "id": "iq.masroofi.app"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://d7laoez.github.io"
    },
    {
      "origin": "https://accounts.google.com"
    }
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/msrofe/*"
        }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?action=add"
    }
  },
  "widgets": [
    {
      "name": "مصروفي السريع",
      "short_name": "مصروفي",
      "description": "معاينة سريعة لملخص مصاريف اليوم والرصيد المتبقي",
      "tag": "masroofi-widget",
      "template": "widget-template",
      "data": "widget-data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "icons/screenshot-mobile.png",
          "sizes": "540x720",
          "label": "معاينة الويدجت السريع"
        }
      ],
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "شاشة التطبيق الرئيسية لإدارة المصاريف"
    },
    {
      "src": "icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة تقارير وإحصائيات المصاريف"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "./index.html?action=add"
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Masroofi Backup File",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+masroofi",
      "url": "./index.html?action=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "إضافة عملية جديدة",
      "short_name": "إضافة",
      "description": "تسجيل مصروف أو دخل جديد فوراً",
      "url": "./index.html?action=add",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "التقارير والإحصائيات",
      "short_name": "التقارير",
      "description": "معاينة تحليل المصاريف والميزانية",
      "url": "./index.html?screen=statistics",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
